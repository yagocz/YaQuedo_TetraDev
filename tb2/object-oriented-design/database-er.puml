@startuml DatabaseER_YaQuedo_TB2
title Modelo Entidad-Relación · Base de Datos Ya Quedó (PostgreSQL 16, alcance TB2)\nPK en negrita · FK en cursiva · UNIQUE indicado en cada tabla

skinparam shadowing false
skinparam linetype ortho
skinparam class {
  BackgroundColor #DBEAFE
  BorderColor #1E40AF
  ArrowColor #4F46E5
}
skinparam package {
  BackgroundColor #F3F4F6
  BorderColor #6B7280
}

' ============ IAM ============
package "IAM (Identity & Access)" #EEF2FF {

  entity "users" as users {
    **id** : UUID  PK
    --
    email : VARCHAR(255) UNIQUE
    password_hash : VARCHAR(255)
    phone : VARCHAR(20) UNIQUE
    status : VARCHAR(30)
    user_type : VARCHAR(30)
    created_at : TIMESTAMP
    last_login_at : TIMESTAMP
  }

  entity "customers" as customers {
    **id** : UUID  PK · //FK → users.id//
    --
    first_name : VARCHAR(100)
    last_name : VARCHAR(100)
  }

  entity "workers" as workers {
    **id** : UUID  PK · //FK → users.id//
    --
    first_name : VARCHAR(100)
    last_name : VARCHAR(100)
    dni : VARCHAR(8) UNIQUE
    bio : TEXT
    rating_avg : DECIMAL(3,2)
    total_services : INT
    verified : BOOLEAN
  }
}

' ============ Identity ============
package "Identity (Verificación manual)" #FEF3C7 {

  entity "identity_verifications" as verif {
    **id** : UUID  PK
    --
    //worker_id// : UUID  FK → workers.id
    dni_front_url : VARCHAR(500)
    dni_back_url : VARCHAR(500)
    selfie_url : VARCHAR(500)
    status : VARCHAR(30)
    submitted_at : TIMESTAMP
    reviewed_at : TIMESTAMP
    rejection_reason : TEXT
    //reviewed_by// : UUID  FK → users.id
  }
}

' ============ Catalog ============
package "Catalog" #DCFCE7 {

  entity "service_categories" as cats {
    **id** : UUID  PK
    --
    name : VARCHAR(100) UNIQUE
    slug : VARCHAR(100) UNIQUE
    description : TEXT
    icon_key : VARCHAR(50)
    active : BOOLEAN
  }

  entity "districts" as districts {
    **id** : UUID  PK
    --
    name : VARCHAR(100)
    region : VARCHAR(100)
    ubigeo : VARCHAR(10)
  }
}

' ============ Worker offerings + coverage ============
package "Worker (Offerings + Coverage)" #FCE7F3 {

  entity "worker_offerings" as offerings {
    **id** : UUID  PK
    --
    //worker_id// : UUID  FK → workers.id
    //category_id// : UUID  FK → service_categories.id
    base_price : DECIMAL(10,2)
    estimated_hours : INT
    active : BOOLEAN
    --
    UNIQUE (worker_id, category_id)
  }

  entity "worker_coverage" as coverage {
    **id** : UUID  PK
    --
    //worker_id// : UUID  FK → workers.id
    //district_id// : UUID  FK → districts.id
    --
    UNIQUE (worker_id, district_id)
  }
}

' ============ Relaciones ============
users ||--|| customers : "1 : 1"
users ||--|| workers : "1 : 1"
workers ||--o{ verif : "1 : N"
workers ||--o{ offerings : "1 : N"
cats ||--o{ offerings : "1 : N"
workers ||--o{ coverage : "1 : N"
districts ||--o{ coverage : "1 : N"

note as N1
  **Alcance TB2 (Sprint 2)** — 8 tablas que materializan
  los 4 Bounded Contexts implementados (IAM, Identity,
  Catalog, Worker).

  · `users` aplica herencia JOINED de JPA: `customers` y
    `workers` comparten PK con `users.id`.
  · `identity_verifications.status` arranca en SUBMITTED,
    pasa a UNDER_REVIEW al subir archivos y queda en
    VERIFIED/REJECTED tras revisión manual del Equipo de
    Soporte (`reviewed_by` apunta a un usuario admin).
  · `service_categories` viene con 6 filas seedeadas;
    `districts` con 15 distritos de Lima Metropolitana.

  Tablas TB3+ (quotes, bookings, payments, reviews,
  badges, courses, notifications, audit_log) **no** se
  implementan en este Sprint — fueron removidas del
  modelo al quitar Yape/Niubiz/RENIEC del alcance.
end note

@enduml
