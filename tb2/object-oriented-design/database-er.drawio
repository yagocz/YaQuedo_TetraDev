          <mxGeometry x="1240" y="520" width="240" height="220" as="geometry" />
        </mxCell>
        <mxCell id="offeringsCols" value="&lt;b&gt;id&lt;/b&gt; : UUID  PK&#xa;&lt;i&gt;worker_id&lt;/i&gt; : UUID  FK&#xa;&lt;i&gt;category_id&lt;/i&gt; : UUID  FK&#xa;base_price : DECIMAL(10,2)&#xa;estimated_hours : INT&#xa;active : BOOLEAN&#xa;&#xa;UNIQUE&#xa;(worker_id, category_id)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;spacingLeft=10;spacingTop=6" vertex="1" parent="offerings">
          <mxGeometry y="32" width="240" height="188" as="geometry" />
        </mxCell>
        <mxCell id="coverage" value="worker_coverage" style="shape=swimlane;fontSize=13;fontStyle=1;startSize=32;align=center;html=1;rounded=0;fillColor=#DBEAFE;strokeColor=#1E40AF" vertex="1" parent="1">
          <mxGeometry x="1500" y="520" width="240" height="220" as="geometry" />
        </mxCell>
        <mxCell id="coverageCols" value="&lt;b&gt;id&lt;/b&gt; : UUID  PK&#xa;&lt;i&gt;worker_id&lt;/i&gt; : UUID  FK&#xa;&lt;i&gt;district_id&lt;/i&gt; : UUID  FK&#xa;&#xa;UNIQUE&#xa;(worker_id, district_id)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;spacingLeft=10;spacingTop=6" vertex="1" parent="coverage">
          <mxGeometry y="32" width="240" height="188" as="geometry" />
        </mxCell>
        <mxCell id="booking" value="Booking (US-06 a US-09)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0369A1;fontSize=13;fontStyle=1;verticalAlign=top;align=center;spacingTop=10" vertex="1" parent="1">
          <mxGeometry x="60" y="840" width="780" height="380" as="geometry" />
        </mxCell>
        <mxCell id="sr" value="service_requests" style="shape=swimlane;fontSize=13;fontStyle=1;startSize=32;align=center;html=1;rounded=0;fillColor=#DBEAFE;strokeColor=#1E40AF" vertex="1" parent="1">
          <mxGeometry x="100" y="890" width="380" height="320" as="geometry" />
        </mxCell>
        <mxCell id="srCols" value="&lt;b&gt;id&lt;/b&gt; : UUID  PK&#xa;&lt;i&gt;customer_id&lt;/i&gt; : UUID  FK → customers.id&#xa;&lt;i&gt;worker_id&lt;/i&gt; : UUID  FK → workers.id&#xa;&lt;i&gt;category_id&lt;/i&gt; : UUID  FK → service_categories.id&#xa;&lt;i&gt;district_id&lt;/i&gt; : UUID  FK → districts.id&#xa;description : TEXT&#xa;urgency : VARCHAR(20)&#xa;status : VARCHAR(20)&#xa;agreed_amount : DECIMAL(10,2)&#xa;scheduled_at : TIMESTAMP&#xa;confirmation_code : VARCHAR(8)&#xa;rejection_reason : TEXT&#xa;created_at : TIMESTAMP&#xa;accepted_at : TIMESTAMP&#xa;completed_at : TIMESTAMP" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;spacingLeft=10;spacingTop=6" vertex="1" parent="sr">
          <mxGeometry y="32" width="380" height="288" as="geometry" />
        </mxCell>
        <mxCell id="reputation" value="Reputation (US-10, US-11)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontSize=13;fontStyle=1;verticalAlign=top;align=center;spacingTop=10" vertex="1" parent="1">
          <mxGeometry x="880" y="840" width="760" height="380" as="geometry" />
        </mxCell>
        <mxCell id="reviews" value="reviews" style="shape=swimlane;fontSize=13;fontStyle=1;startSize=32;align=center;html=1;rounded=0;fillColor=#DBEAFE;strokeColor=#1E40AF" vertex="1" parent="1">
          <mxGeometry x="920" y="890" width="380" height="300" as="geometry" />
        </mxCell>
        <mxCell id="reviewsCols" value="&lt;b&gt;id&lt;/b&gt; : UUID  PK&#xa;&lt;i&gt;service_request_id&lt;/i&gt; : UUID  UNIQUE FK → service_requests.id&#xa;&lt;i&gt;customer_id&lt;/i&gt; : UUID  FK → customers.id&#xa;&lt;i&gt;worker_id&lt;/i&gt; : UUID  FK → workers.id&#xa;rating : INT  CHECK (1-5)&#xa;comment : TEXT&#xa;worker_response : TEXT&#xa;flagged : BOOLEAN&#xa;published_at : TIMESTAMP&#xa;responded_at : TIMESTAMP&#xa;&#xa;UNIQUE (service_request_id)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;spacingLeft=10;spacingTop=6" vertex="1" parent="reviews">
          <mxGeometry y="32" width="380" height="268" as="geometry" />
        </mxCell>
        <mxCell id="notes" value="Notas del modelo TB2 (10 tablas, 11 User Stories)&#xa;&#xa;· `users` aplica herencia JOINED de JPA: customers y workers comparten PK con users.id&#xa;· `identity_verifications` queda en UNDER_REVIEW hasta que el Equipo de Soporte aprueba o rechaza manualmente (reemplaza al adapter RENIEC removido)&#xa;· `service_categories` viene seedeado con 6 categorías iniciales; `districts` con 15 distritos de Lima (ubigeo INEI)&#xa;· `service_requests.status` aplica una state machine controlada en la entidad: PENDING → ACCEPTED → SCHEDULED → CONFIRMED → COMPLETED (o REJECTED/CANCELLED/EXPIRED)&#xa;· `reviews.service_request_id` es UNIQUE: solo 1 reseña por servicio. Al insertarse, el sistema recalcula `workers.rating_avg` y `workers.total_services` como agregados de todas las reseñas no flagged" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=11;fillColor=#F3F4F6;strokeColor=#6B7280;spacingLeft=12;spacingTop=10" vertex="1" parent="1">
          <mxGeometry x="60" y="1260" width="1580" height="220" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="LEYENDA · Notación Crow's Foot (10 tablas)&#xa;&#xa;Color de fondo del paquete = Bounded Context&#xa;◼ IAM (violeta) — users, customers, workers&#xa;◼ Identity (ámbar) — identity_verifications&#xa;◼ Catalog (verde) — service_categories, districts&#xa;◼ Worker (rosa) — worker_offerings, worker_coverage&#xa;◼ Booking (celeste) — service_requests&#xa;◼ Reputation (rojo claro) — reviews&#xa;&#xa;PK · en negrita&#xa;FK · en cursiva con flecha →&#xa;UNIQUE · restricción declarada en la tabla&#xa;&#xa;Cardinalidad:&#xa;  1 — exactamente uno&#xa;  N — uno o más" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=11;fillColor=#F3F4F6;strokeColor=#6B7280;spacingLeft=12;spacingTop=10" vertex="1" parent="1">
          <mxGeometry x="1800" y="110" width="380" height="380" as="geometry" />
        </mxCell>
