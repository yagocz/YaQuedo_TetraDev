        <mxCell id="title" value="Modelo Entidad-Relación · Base de Datos Ya Quedó (PostgreSQL 16, alcance TB2 — 10 tablas para las 11 US)&#xa;PK en negrita · FK en cursiva · UNIQUE indicado en cada tabla" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=17;fontStyle=1" vertex="1" parent="1">
