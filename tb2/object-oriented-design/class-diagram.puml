@startuml ClassDiagram_YaQuedo_TB2
title Diagrama de Clases · Dominio Ya Quedó (alcance TB2 — 4 Bounded Contexts implementados)\nIAM · Identity · Catalog · Worker

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #1F2937
  ArrowColor #6366F1
}
skinparam package {
  BackgroundColor #F3F4F6
  BorderColor #6B7280
}

' ============ Bounded Context · IAM ============
package "IAM (Identity & Access Management)" #EEF2FF {

  abstract class User {
    - id : UUID
    - email : String
    - passwordHash : String
    - phone : String
    - status : UserStatus
    - createdAt : LocalDateTime
    - lastLoginAt : LocalDateTime
    --
    + activate() : void
    + recordLogin() : void
    + getUserType() : String
  }

  class Customer extends User {
    - firstName : String
    - lastName : String
    --
    + getUserType() : String
  }

  class Worker extends User {
    - firstName : String
    - lastName : String
    - dni : String
    - bio : String
    - ratingAvg : BigDecimal
    - totalServices : int
    - verified : boolean
    --
    + isTopRated() : boolean
    + markVerified() : void
    + getUserType() : String
  }

  enum UserStatus {
    PENDING_VERIFICATION
    ACTIVE
    SUSPENDED
    BLOCKED
  }
}

' ============ Bounded Context · Identity ============
package "Identity (Verificación manual)" #FEF3C7 {

  class IdentityVerification {
    - id : UUID
    - workerId : UUID
    - dniFrontUrl : String
    - dniBackUrl : String
    - selfieUrl : String
    - status : VerificationStatus
    - submittedAt : LocalDateTime
    - reviewedAt : LocalDateTime
    - rejectionReason : String
    --
    + approve() : void
    + reject(reason : String) : void
  }

  enum VerificationStatus {
    SUBMITTED
    UNDER_REVIEW
    VERIFIED
    REJECTED
  }
}

' ============ Bounded Context · Catalog ============
package "Catalog" #DCFCE7 {

  class ServiceCategory {
    - id : UUID
    - name : String
    - slug : String
    - description : String
    - iconKey : String
    - active : boolean
  }

  class District {
    - id : UUID
    - name : String
    - region : String
    - ubigeo : String
  }
}

' ============ Bounded Context · Worker (Profile + Offerings + Coverage) ============
package "Worker (Profile + Offerings + Coverage)" #FCE7F3 {

  class WorkerOffering {
    - id : UUID
    - workerId : UUID
    - categoryId : UUID
    - basePrice : BigDecimal
    - estimatedHours : int
    - active : boolean
    --
    UNIQUE (workerId, categoryId)
  }

  class WorkerCoverage {
    - id : UUID
    - workerId : UUID
    - districtId : UUID
    --
    UNIQUE (workerId, districtId)
  }
}

' ============ Relaciones ============
User ..> UserStatus : usa
IdentityVerification ..> VerificationStatus : usa
Worker "1" -- "0..*" IdentityVerification : valida con >
Worker "1" -- "0..*" WorkerOffering : ofrece >
Worker "1" -- "0..*" WorkerCoverage : opera en >
ServiceCategory "1" -- "0..*" WorkerOffering : tipo de >
District "1" -- "0..*" WorkerCoverage : cubre <

note as N1
  **Alcance TB2 (Sprint 2)**

  Este diagrama refleja únicamente las
  entidades implementadas en US-11 a US-17.

  Booking, Quote, Payment, Review, Badge
  y Course se diseñarán en TB3 cuando se
  incorporen pasarelas de pago y el flujo
  completo de contratación.

  Las pasarelas Yape/Niubiz y el adapter
  RENIEC fueron removidos del alcance por
  no ser accesibles. La verificación de
  identidad la hace el Equipo de Soporte
  manualmente sobre las imágenes en MinIO.
end note

@enduml
