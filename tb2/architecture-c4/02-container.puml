@startuml C4_Container_YaQuedo
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()
title Diagrama de Contenedores · Ya Quedó (Nivel 2 · C4 Model)

Person(cliente, "Cliente", "Persona que contrata servicios.")
Person(trabajador, "Trabajador", "Técnico independiente.")
Person(soporte, "Soporte TetraDev", "Modera y verifica manualmente.")

System_Boundary(yaQuedo, "Plataforma Ya Quedó") {

    Container(landing, "Landing Page", "HTML5 + CSS3 + JS", "Sitio público con propuesta de valor, formulario de pre-registro, FAQ y páginas legales. Cubre US-01 a US-10.")

    Container(webApp, "Web Application (SPA)", "Angular 17 + TypeScript", "Aplicación responsive (desktop/mobile) que ejecuta los flujos logueados: registro, búsqueda, perfil del trabajador, calificaciones.")

    Container(api, "Web Services (API REST)", "Spring Boot 3.2 + Java 21", "API RESTful con DDD: 6 Bounded Contexts (IAM, Identity, Catalog, Worker, Booking, Reputation). 24 endpoints REST cubriendo 11 User Stories. Expone OpenAPI/Swagger en /swagger-ui.html.")

    ContainerDb(db, "Base de Datos", "PostgreSQL 16", "10 tablas: users, customers, workers, identity_verifications, service_categories, districts, worker_offerings, worker_coverage, service_requests, reviews.")

    ContainerDb(cache, "Cache", "Redis 7", "Almacena OTPs (TTL 5 min), rate-limiting de login y sesiones JWT.")

    Container(storage, "Object Storage", "MinIO (S3-compatible, local)", "Almacena fotos del DNI, selfies y fotos de perfil del trabajador.")
}

System_Ext(emailApi, "Servicio Correo", "SMTP / SendGrid free")
System_Ext(osm, "OpenStreetMap", "Tiles vía Leaflet")
System_Ext(ga4, "Google Analytics 4", "gtag.js")

' Personas → Containers
Rel(cliente, landing, "Visita propuesta de valor, deja pre-registro", "HTTPS")
Rel(cliente, webApp, "Busca y contrata trabajadores", "HTTPS")
Rel(trabajador, landing, "Conoce beneficios", "HTTPS")
Rel(trabajador, webApp, "Verifica DNI, gestiona perfil, responde solicitudes", "HTTPS")
Rel(soporte, webApp, "Aprueba/rechaza verificaciones, modera reseñas", "HTTPS")

' Containers → Backend
Rel(landing, ga4, "Eventos page_view, form_submit", "HTTPS")
Rel(webApp, api, "JWT + JSON sobre todos los endpoints", "HTTPS / JSON")
Rel(landing, api, "POST /pre-register", "HTTPS / JSON")
Rel(webApp, osm, "Renderiza mapas de cobertura del trabajador", "HTTPS")

' Backend → Persistencia
Rel(api, db, "Lee y escribe datos de dominio", "JDBC / TLS")
Rel(api, cache, "Cachea OTP y rate-limit", "Redis Protocol")
Rel(api, storage, "Sube/recupera fotos DNI y selfie", "HTTPS / S3 API")

' Backend → Servicios externos
Rel(api, emailApi, "Envía OTP y notificaciones", "SMTP")

@enduml
