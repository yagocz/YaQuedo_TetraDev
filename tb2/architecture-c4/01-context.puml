@startuml C4_Context_YaQuedo
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_WITH_LEGEND()
title Diagrama de Contexto · Ya Quedó (Nivel 1 · C4 Model)

' ============ Personas / Actores ============
Person(cliente, "Cliente", "Persona de Lima Metropolitana (25-55 años, NSE B/C) que requiere servicios técnicos del hogar.")
Person(trabajador, "Trabajador Independiente", "Técnico (electricista, gasfitero, pintor, cerrajero) de 22-60 años que ofrece sus servicios.")
Person(soporte, "Equipo de Soporte TetraDev", "Modera, resuelve reclamos y verifica manualmente los documentos de identidad enviados por los trabajadores.")

' ============ Sistema principal ============
System(yaQuedo, "Plataforma Ya Quedó", "Marketplace digital que conecta clientes con trabajadores técnicos verificados. Cubre el ciclo completo: registro y login (US-01, US-02), búsqueda con filtros y visualización de perfiles (US-03 a US-05), solicitud-aceptación-agenda-confirmación de servicios (US-06 a US-09) y sistema de calificaciones y reputación (US-10, US-11).")

' ============ Sistemas externos (todos gratuitos / accesibles) ============
System_Ext(emailApi, "Servicio de Correo\n(SMTP o SendGrid free tier)", "Envío de OTP de registro y notificaciones transaccionales por email.")
System_Ext(osm, "OpenStreetMap", "Tiles de mapas gratuitos para mostrar cobertura del trabajador (vía Leaflet.js).")
System_Ext(ga4, "Google Analytics 4", "Analítica de uso y eventos del landing.")

' ============ Relaciones Persona → Sistema ============
Rel(cliente, yaQuedo, "Busca, contrata y califica servicios", "HTTPS")
Rel(trabajador, yaQuedo, "Publica perfil, recibe solicitudes, gestiona cobros", "HTTPS")
Rel(soporte, yaQuedo, "Revisa documentos, modera reseñas, resuelve disputas", "HTTPS")

' ============ Relaciones Sistema → Externos ============
Rel(yaQuedo, emailApi, "Envía OTP y correos transaccionales", "SMTP / REST")
Rel(yaQuedo, osm, "Renderiza tiles de mapas en la app", "HTTPS")
Rel(yaQuedo, ga4, "Reporta eventos de uso del landing", "HTTPS")

@enduml
