@startuml C4_Component_YaQuedo_Backend
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()
title Diagrama de Componentes · Backend Ya Quedó (Nivel 3 · C4 Model)\n6 Bounded Contexts según DDD — 11 User Stories del segmento Usuario que Contrata

Container(webApp, "Web Application", "Angular SPA")

System_Boundary(api, "Web Services · Spring Boot 3.2") {

    ' ============ Bounded Context: IAM (US-01, US-02) ============
    Component(authController, "AuthController", "@RestController", "POST /auth/register, /auth/otp/verify, /auth/login, /auth/recover")
    Component(authService, "AuthenticationService", "@Service", "Orquesta registro, OTP, login. Hashea con BCrypt cost 12, emite JWT.")
    Component(otpService, "OtpService", "@Service", "Genera código de 6 dígitos, guarda en Redis con TTL 5 min.")
    Component(jwtProvider, "JwtTokenProvider", "@Component", "Firma y valida JWT HS256.")
    Component(userRepo, "UserRepository", "@Repository", "Persistencia de Customer y Worker (herencia JOINED).")

    ' ============ Bounded Context: Identity (auxiliar) ============
    Component(verifController, "VerificationController", "@RestController", "POST /workers/{id}/verify-identity (multipart), GET /verifications/{id}")
    Component(verifService, "VerificationService", "@Service", "Valida archivos (≤5MB, JPEG/PNG). UNDER_REVIEW para revisión manual del Equipo de Soporte.")
    Component(minioAdapter, "MinioStorageAdapter", "@Component", "Sube DNI y selfie a MinIO local (S3-compatible).")
    Component(verifRepo, "VerificationRepository", "@Repository", "Persistencia de IdentityVerification.")

    ' ============ Bounded Context: Catalog (apoyo US-03) ============
    Component(catController, "CategoryController", "@RestController", "GET /categories — 6 categorías iniciales.")
    Component(catRepo, "CategoryRepository", "@Repository", "Persistencia de ServiceCategory.")
    Component(distRepo, "DistrictRepository", "@Repository", "15 distritos de Lima seedeados.")

    ' ============ Bounded Context: Worker (US-03, US-04, US-05) ============
    Component(workerController, "WorkerController", "@RestController", "PUT /workers/me, POST /workers/me/offerings, PUT /workers/me/coverage, GET /workers/search, GET /workers/{id}")
    Component(workerProfileService, "WorkerProfileService", "@Service", "Actualiza perfil, oficios (máx 10) y cobertura.")
    Component(workerSearchService, "WorkerSearchService", "@Service", "Búsqueda con filtros (categoría/distrito/rating/precio). Fallback a categoría si distrito vacío.")
    Component(workerOffRepo, "Worker*Repository", "@Repository", "WorkerOfferingRepository, WorkerCoverageRepository.")

    ' ============ Bounded Context: Booking (US-06, US-07, US-08, US-09) ============
    Component(srController, "ServiceRequestController", "@RestController", "POST /service-requests, /me, /inbox, /{id}, /{id}/accept, /{id}/reject, /{id}/schedule, /{id}/confirm, /{id}/complete")
    Component(srService, "ServiceRequestService", "@Service", "State machine PENDING → ACCEPTED → SCHEDULED → CONFIRMED → COMPLETED. Máx 3 activas por trabajador. Genera código de confirmación 6 chars.")
    Component(srRepo, "ServiceRequestRepository", "@Repository", "findByCustomerId, findByWorkerId, countByWorkerAndStatus.")
    Component(srAgg, "ServiceRequest", "Aggregate root", "Encapsula transiciones de estado y reglas de negocio (accept, reject, schedule, confirm, complete).")

    ' ============ Bounded Context: Reputation (US-10, US-11) ============
    Component(reviewController, "ReviewController", "@RestController", "POST /reviews, POST /reviews/{id}/respond, GET /workers/{id}/reviews")
    Component(reviewService, "ReviewService", "@Service", "Valida estado COMPLETED previo. Anti-duplicado por service_request_id. Recalcula ratingAvg del Worker al insertar.")
    Component(reviewRepo, "ReviewRepository", "@Repository", "findByWorkerIdOrderByPublishedAt, findByServiceRequestId.")
    Component(reviewAgg, "Review", "Aggregate", "rating 1-5, workerResponse opcional, flagged para moderación.")

    ' ============ Cross-cutting ============
    Component(security, "SecurityConfig", "@Configuration", "Spring Security stateless con JWT y BCrypt. Whitelist de /auth/*, /categories, /workers/search, /workers/{id}/reviews, swagger-ui.")
    Component(exceptionHandler, "GlobalExceptionHandler", "@RestControllerAdvice", "Mapeo uniforme de excepciones a HTTP 400/401/404/409/422.")
    Component(emailAdapter, "EmailAdapter", "@Component", "Envío de OTP y notificaciones por SMTP (SendGrid free o Gmail App Password).")
    Component(openapiCfg, "OpenApiConfig", "@Configuration", "Configura springdoc-openapi. Swagger UI en /swagger-ui.html.")
    Component(apiResp, "ApiResponse<T>", "shared-kernel", "Envuelve data + meta en todas las respuestas exitosas.")
}

ContainerDb(db, "PostgreSQL 16", "10 tablas (users, customers, workers, identity_verifications, service_categories, districts, worker_offerings, worker_coverage, service_requests, reviews)")
ContainerDb(redis, "Redis 7", "Cache / OTP / rate-limit")
Container(storage, "MinIO", "Object storage S3-compatible (local)")
System_Ext(emailExt, "Email Service (SMTP)", "SendGrid free / Gmail SMTP")

' ============ Flujos principales ============
Rel(webApp, authController, "POST /auth/*", "JSON / JWT")
Rel(webApp, verifController, "POST /workers/{id}/verify-identity", "multipart/form-data")
Rel(webApp, catController, "GET /categories")
Rel(webApp, workerController, "GET /workers/search, /workers/{id}, PUT/POST /workers/me/*")
Rel(webApp, srController, "POST /service-requests + flujo de aceptación/agenda")
Rel(webApp, reviewController, "POST /reviews, GET /workers/{id}/reviews")

Rel(authController, authService, "")
Rel(authService, otpService, "Emite OTP")
Rel(authService, jwtProvider, "Emite JWT")
Rel(authService, userRepo, "Lee/guarda User")
Rel(otpService, redis, "Guarda OTP TTL 5 min")
Rel(otpService, emailAdapter, "Envía OTP")

Rel(verifController, verifService, "")
Rel(verifService, minioAdapter, "Sube archivos")
Rel(verifService, verifRepo, "Persiste verificación")
Rel(minioAdapter, storage, "putObject / getObject", "S3 API")

Rel(catController, catRepo, "findByActiveTrueOrderByName")
Rel(workerController, workerProfileService, "")
Rel(workerController, workerSearchService, "")
Rel(workerProfileService, workerOffRepo, "")
Rel(workerSearchService, workerOffRepo, "")
Rel(workerSearchService, userRepo, "Filtra workers por rating")

Rel(srController, srService, "")
Rel(srService, srRepo, "")
Rel(srRepo, srAgg, "Persiste agregado")

Rel(reviewController, reviewService, "")
Rel(reviewService, reviewRepo, "")
Rel(reviewService, srService, "Valida estado COMPLETED")
Rel(reviewService, userRepo, "Recalcula ratingAvg del Worker")
Rel(reviewRepo, reviewAgg, "Persiste agregado")

Rel(emailAdapter, emailExt, "SMTP")

Rel(userRepo, db, "JDBC")
Rel(verifRepo, db, "JDBC")
Rel(catRepo, db, "JDBC")
Rel(distRepo, db, "JDBC")
Rel(workerOffRepo, db, "JDBC")
Rel(srRepo, db, "JDBC")
Rel(reviewRepo, db, "JDBC")

@enduml
